    },
    {
      "id": "outcome.02.victory",
      "category": "outcome",
      "status": "generated",
      "script": "Another sealed access point gives way.\n\nAcross the crypt, forced hatchways and shattered breach points now form a path through defenses never meant to be opened from within.\n\nThe tomb can no longer contain the route.\n\nThe way forward is open.\n\nMission accomplished.",
      "scriptHash": "85d83a4418e088f523c96444bcff8c25ce2942aff6b3505370bf2e6a1a54a8a6",
