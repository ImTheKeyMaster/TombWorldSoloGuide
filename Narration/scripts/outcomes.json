    },
    {
      "id": "outcome.04.defeat",
      "category": "outcome",
      "status": "generated",
      "script": "The sarcophagus endures.\n\nFractures begin to close as living metal flows back across its surface. One by one, damaged systems stabilize and the chamber falls into an unnatural calm.\n\nThe opportunity is gone.\n\nThe tomb has preserved what sleeps within.",
      "scriptHash": "056f69fbb318e5484335030f7c2a6d7debad7894f50eec7a40e2a5a0fdbae14a",
