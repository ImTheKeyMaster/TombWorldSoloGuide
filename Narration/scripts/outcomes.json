    {
      "id": "outcome.03.victory",
      "category": "outcome",
      "status": "generated",
      "script": "The carrier crosses the boundary with the transponder still in hand.\n\nBehind them, the signal fades beneath layers of stone and living metal, but this time it is leaving the crypt with you.\n\nThe device is secure.\n\nExtraction successful.\n\nMission accomplished.",
      "scriptHash": "30cf70d309c196ee14524ff45b6d467b2994b8dc5bba284c058e4be1fa662371",
      "outputFile": "outcomes/03-recover-transponder-victory.mp3",
