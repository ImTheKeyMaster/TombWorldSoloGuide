    },
    {
      "id": "outcome.05.victory",
      "category": "outcome",
      "status": "generated",
      "script": "Another chamber falls silent.\n\nEnough of the sub-crypt has now been opened, cleared and mapped to reveal the shape of what lies beneath the Tomb World.\n\nThe darkness still holds many secrets.\n\nBut not these.\n\nThe reconnaissance is complete.\n\nMission accomplished.",
      "scriptHash": "e3c61ba9824472b20524d5deee776f4fc1755a6cf5772d14ad986b548f0594c9",
      "outputFile": "outcomes/05-scout-sub-crypt-victory.mp3",
