      "voiceId": "keNGlRe631vnQRvGXasN",
      "modelId": "eleven_multilingual_v2"
    },
    {
      "id": "outcome.05.defeat",
      "category": "outcome",
      "status": "generated",
      "script": "The exploration ends here.\n\nBeyond the chambers you reached, sealed rooms continue into the darkness, their contents unknown and their guardians undisturbed.\n\nToo much of the sub-crypt remains hidden.\n\nThe tomb keeps its secrets.\n\nMission failed.",
      "scriptHash": "6f86d5744e97679db54ae932adf50b7bea6a98d9b8e97f74ed40bcd5fec5b961",
