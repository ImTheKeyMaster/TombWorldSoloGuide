    {
      "id": "outcome.06.victory",
      "category": "outcome",
      "status": "generated",
      "script": "One by one, the survivors emerge from the tomb's phasing routes.\n\nScattered warriors become a formation again, gathering together beyond the maze of impossible passages.\n\nThe tomb divided you.\n\nIt could not keep you apart.\n\nThe team is reunited.\n\nMission accomplished.",
      "scriptHash": "d246ed5d2d2d35b3f191e9699fb162e83475cf4a60d1e998a976430c596e3242",
