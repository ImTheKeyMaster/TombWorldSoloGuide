{
  "$schema": "./mission.schema.json",
  "schemaVersion": 1,
  "id": "03",
  "slug": "recover-transponder",
  "name": "Recover Transponder",
  "briefing": "Search the three objective markers for the transponder, then escape through Player A's killzone edge while carrying it.",
  "objectiveSummary": "Find the transponder and escape through Player A's killzone edge.",
  "runtime": {
    "markers": [
      { "id": "site-1", "label": "Objective Marker 1", "initialState": "available" },
      { "id": "site-2", "label": "Objective Marker 2", "initialState": "available" },
      { "id": "site-3", "label": "Objective Marker 3", "initialState": "available" }
    ],
    "initial": { "transponderFound": false, "carrierOperativeId": null, "transponderStatus": "unknown", "searchSitesResolved": 0, "missionCompleted": false, "extractionConfirmed": false }
  },
  "stages": { "search": "LOCATE TRANSPONDER", "extraction": "EXTRACT TRANSPONDER" },
  "objectives": [
    {
      "id": "transponderRecovered",
      "type": "counter",
      "label": "Transponder Recovered",
      "initial": 0,
      "minimum": 0,
      "maximum": 1,
      "target": 1,
      "lockOnComplete": true,
      "completion": { "operator": ">=", "value": 1 }
    }
  ],
  "actions": [
    {
      "id": "searchTransponder",
      "label": "Pick Up Marker",
      "description": "Roll D3 after an operative picks up an unresolved objective marker.",
      "apCost": 1,
      "diceExpression": "1D3",
      "comparison": "roll > otherRemainingMarkerCount",
      "availability": {
        "all": [
          { "path": "mission.objectives.transponderRecovered.completed", "operator": "==", "value": false }
        ]
      },
      "operations": [
        { "type": "requestDiceRoll", "id": "searchRoll", "dice": { "count": 1, "sides": 3 }, "label": "Locate Item" }
      ]
    },
    {
      "id": "recordTransponderEscape",
      "label": "Recover Transponder",
      "availability": {
        "all": [
          { "path": "mission.objectives.transponderRecovered.completed", "operator": "==", "value": false }
        ]
      },
      "operations": [
        { "type": "setCounter", "objectiveId": "transponderRecovered", "value": 1 }
      ]
    }
  ],
  "hooks": {},
  "completion": {
    "objectiveId": "transponderRecovered",
    "operator": ">=",
    "value": 1,
    "endsBattle": true,
    "dialogId": "objectiveComplete"
  },
  "hud": {
    "label": "MISSION",
    "search": { "format": "SEARCH {resolved}/3" },
    "extraction": { "format": "TRANSPONDER FOUND" },
    "complete": { "format": "✓ COMPLETE" }
  },
  "dialogs": {
    "selectMarker": { "title": "LOCATE ITEM", "message": "Which objective marker is this operative searching?" },
    "notFound": { "title": "ITEM NOT FOUND", "message": "Objective Marker {marker} was a false signal." },
    "found": { "title": "TRANSPONDER FOUND", "message": "Objective Marker {marker} contains the transponder." },
    "confirmEscape": { "title": "CONFIRM ESCAPE", "message": "Has {operative} crossed Player A's killzone edge while carrying the transponder?" },
    "objectiveComplete": {
      "title": "TRANSPONDER RECOVERED",
      "message": "The carrier escaped through Player A's killzone edge with the transponder."
    }
  },
  "presentation": { "historyDisplayCount": 8, "showHud": true },
  "narration": { "introduction": "mission-03-introduction", "victory": "mission-03-victory", "defeat": "mission-03-defeat" }
}
